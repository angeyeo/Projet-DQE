# ================================================================
# Variables d'environnement du projet DQE
# Copiez ce fichier en .env et remplissez les valeurs.
#   cp .env.example .env
# ================================================================

# --- Mode démo (authentification) ---
# True  = endpoints IA accessibles sans authentification (démo jury)
# False = endpoints IA sécurisés par IsAuthenticated (production)
DEMO_MODE=False

# --- Assistant IA (Gemini) ---
# Fournisseur : "mock" (simulation locale) ou "gemini" (API réelle Google)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Timeout fournisseur LLM en secondes — 60 recommandé pour Gemini Vision
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RESPONSE_BYTES=65536

# --- Taille limite d'upload ---
# Taille maximale autorisée en octets pour les images de plans (Vision) - 5 Mo par défaut
PLAN_IMAGE_MAX_BYTES=5242880
