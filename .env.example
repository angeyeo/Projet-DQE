# ================================================================
# Variables d'environnement du projet DQE
# Copiez ce fichier en .env et remplissez les valeurs.
#   cp .env.example .env
# ================================================================

# --- Mode démo : SUPPRIMÉ (toutes les API exigent un compte rattaché à un cabinet) ---

# --- Assistant IA (Gemini) ---
# Fournisseur : "gemini" (API réelle). "mock" = simulation locale, à réserver aux tests/démos.
# Absent = assistant IA désactivé (erreur 503 explicite, jamais de simulation silencieuse).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Timeout fournisseur LLM en secondes — 60 recommandé pour Gemini Vision
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RESPONSE_BYTES=65536

# --- Taille limite d'upload ---
# Taille maximale autorisée en octets pour les images de plans (Vision) - 5 Mo par défaut
PLAN_IMAGE_MAX_BYTES=5242880

# --- Sécurité / déploiement ---
# En production Railway, renseignez ces variables dans Railway (ne pas les mettre dans Git).
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.ivoireinnovationbtp.com,.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.ivoireinnovationbtp.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://www.ivoireinnovationbtp.com
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# --- HTTPS strict (optionnel, après vérification du proxy TLS) ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0